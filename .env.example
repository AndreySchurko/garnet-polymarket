# Environment for garnet-core. Contract addresses are filled in; secrets are not.
#
# On the host: copy to ~/garnet-polymarket/.env, fill in the six values below, then
# `chmod 600 .env`. The file is never committed (.gitignore).
#
# Running with it:  set -a; . ./.env; set +a; cargo run --bin garnet-core -- ...

# --- To be filled in by the operator ------------------------------------------
# Trading account: the address the L2 keys were issued for.
POLY_ADDRESS=
# CLOB L2 keys (issued in the Polymarket UI).
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
# Signer private key, and the address holding the collateral.
PRIVATE_KEY=
POLY_PROXY_ADDRESS=
# Polygon RPC endpoints, comma-separated. polygon-rpc.com and Ankr require a
# key; https://polygon-bor-rpc.publicnode.com answers anonymously.
POLYGON_RPC_URLS=

# --- Mode ---------------------------------------------------------------------
# The signature type must match how the account was created:
#   EOA              — trading directly from an EOA (rare for web sign-ups)
#   POLY_PROXY       — Polymarket proxy: sign-in via Magic Link / email / Google
#   POLY_GNOSIS_SAFE — Gnosis Safe: sign-in via MetaMask / WalletConnect
# Browser-wallet users MUST use POLY_GNOSIS_SAFE. It is verified against the
# chain: if the funder answers masterCopy() (selector 0xa619486e), it is a Safe.
# Preflight performs this check itself.
POLY_SIGNATURE_TYPE=POLY_GNOSIS_SAFE
# In TEST, no chain transactions are sent.
TRADING_MODE=LIVE
POLYGON_CHAIN_ID=137

# --- Polymarket V2 contracts on Polygon ---------------------------------------
# Verified against the SDK and docs.polymarket.com on 2026-08-09. The collateral
# must be USDC.e: CollateralOnramp.paused(native USDC) = true.
POLYGON_USDC_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
POLYGON_PUSD_ADDRESS=0xC011a7E12a19f7B1f670d46F03B03f3342E82DFB
POLYGON_COLLATERAL_ONRAMP_ADDRESS=0x93070a847efEf7F70739046A929D47a521F5B8ee
POLYGON_COLLATERAL_OFFRAMP_ADDRESS=0x2957922Eb93258b93368531d39fAcCA3B4dC5854
POLYGON_CTF_EXCHANGE_V2_ADDRESS=0xE111180000d2663C0091e4f400237545B87B996B
POLYGON_NEG_RISK_CTF_EXCHANGE_V2_ADDRESS=0xe2222d279d744050d28e00520010520000310F59
POLYGON_CTF_ADDRESS=0x4D97DCd97eC945f40cF65F87097ACe5EA0476045
# Redemption pays out in pUSD; the V1 adapter 0xd91E80cF… is not used.
POLYGON_CTF_COLLATERAL_ADAPTER_ADDRESS=0xAdA100Db00Ca00073811820692005400218FcE1f
POLYGON_NEG_RISK_CTF_COLLATERAL_ADAPTER_ADDRESS=0xadA2005600Dec949baf300f4C6120000bDB6eAab

# Telegram bot (`garnet-tg`). The token comes from @BotFather; the chat id comes
# from @userinfobot and goes into `[telegram] allowed_chat_ids` in the config,
# not here.
TELEGRAM_BOT_TOKEN=
